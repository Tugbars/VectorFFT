+    ^ cd (Printf.sprintf "_u2_%s" qid) (Printf.sprintf "%s(%s, %s)" unlo srcs.(2) srcs.(3))
+    ^ cd (Printf.sprintf "_u3_%s" qid) (Printf.sprintf "%s(%s, %s)" unhi srcs.(2) srcs.(3))

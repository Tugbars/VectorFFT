# Auto detect text files and perform LF normalization
* text=auto

# DAG-compiler output: ~350k lines of machine-generated codelets.
# Excluded from GitHub's language-percentage bar; files stay in the repo and
# remain fully browsable/downloadable. The decision-making code (core/ + *.ml)
# is intentionally NOT excluded so it still counts.
src/dag-fft-compiler/codelets/**            linguist-generated
# ...but hand-written docs inside that tree are NOT generated: keep them
# reviewable in diffs (Markdown does not affect the language bar either way).
src/dag-fft-compiler/codelets/**/*.md      -linguist-generated

# DAG-compiler generated headers (registries, plan_executors, etc.) — also
# machine output, not decision-making code. Excluded from the language bar.
src/dag-fft-compiler/generator/generated/** linguist-generated

# Everything under docs/roadmap/ (plans, prototype harnesses, their .c benches
# and result logs) is reference material, not part of the library: excluded
# from the language bar whatever its extension.
docs/roadmap/**        linguist-vendored
docs/roadmap/**/*.c    linguist-vendored

# Cost-model code (and its generated tables) — excluded from the language bar.
src/dag-fft-compiler/generator/cost_model/** linguist-vendored

# The gauntlet (2026-09-22): the measurement tool -- the bench, the probes, the
# Python driver and its results. Tooling, not library code; excluded from the
# language bar.
gauntlet/** linguist-vendored

# The gate suite: correctness gates and their runner. Tooling, not library
# code; excluded from the language bar.
src/tools/gates/*.c linguist-vendored
src/tools/gates/** linguist-vendored

# JIT runtime-codegen OUTPUT (machine-generated .c/.dll codelets emitted at
# runtime). Visible/browsable in the repo, but excluded from the language bar —
# same rationale as the static codelets.
src/dag-fft-compiler/jit/generated/** linguist-generated

# The language bar represents the shipped library = src/core. Everything else
# C-shaped is scaffolding: the public-header shim, generator-side tooling,
# and the JIT prelude/runtime C surface.
include/**                                linguist-vendored
src/dag-fft-compiler/generator/scripts/** linguist-vendored
src/dag-fft-compiler/jit/**               linguist-vendored

# HTML anywhere in this repo is a project page or a rendered report, never
# library code — without this the site markup shows up in the language bar as
# if the project were part HTML. Extension-scoped rather than path-scoped so a
# future page lands excluded wherever it is written.
*.html                                     linguist-vendored
*.htm                                      linguist-vendored

# Research notes, roadmaps, wisdom records and performance ledgers. These are
# the project's written record, not its product — counted as documentation so
# the language bar reflects CODE (README.md and in-tree .md stay counted).
docs/** linguist-documentation

# wisdom2 store: LF everywhere — in repo AND on disk (writers emit "wb"/LF;
# this pin kills the Git-Bash-sed CRLF trap at the root). See
# src/core/wisdom2/README.md §2.3.
src/wisdom/**/*.txt text eol=lf
# Refactor baseline artifacts are diffed byte-for-byte across the migration;
# a CRLF conversion would make every line differ. Pin them the same way.
src/tools/baseline/reference/** text eol=lf
# ...except the identity OBJECT: a binary. Under the text rule autocrlf
# normalized its bytes at `git add` and every committed vfft_baseline.o was
# unreadable ("bad string table size") on the next checkout (found 2026-09-03).
src/tools/baseline/reference/*.o binary

# wisdom2 TRANSITIONAL tooling — the one-shot migrator dies with the legacy
# wisdom files (campaign wave 5 / v1.0). Excluded from the language bar; the
# permanent module (wisdom2.h, the reader, selftest, README) stays counted as
# shipped library code.
src/core/wisdom2/wisdom2_migrate.h linguist-vendored

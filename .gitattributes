# Auto detect text files and perform LF normalization
* text=auto

# Treat notebooks as binary (skip diff/merge noise)
*.ipynb linguist-generated
*.ipynb -diff

# Auto-generated headers — collapse in GitHub diff views, do not hand-edit.
# (the old `src/core/generated/*` rule was dead: that directory does not exist.)
# The python-generated trig tables under src/core/transforms/trig/ ARE generated
# (scripts/reference/gen_dct*.py) and self-declare it in their header comment.
src/core/transforms/trig/dct2_n8_avx2.h linguist-generated
src/core/transforms/trig/dct3_n8_avx2.h linguist-generated

# DAG-compiler output: ~350k lines of machine-generated codelets.
# Excluded from GitHub's language-percentage bar; files stay in the repo and
# remain fully browsable/downloadable. The decision-making code (core/ + *.ml)
# is intentionally NOT excluded so it still counts.
src/dag-fft-compiler/codelets/**            linguist-generated
# ...but hand-written docs inside that tree are NOT generated: keep them
# reviewable in diffs (Markdown does not affect the language bar either way).
src/dag-fft-compiler/codelets/**/*.md      -linguist-generated

# DAG-compiler generated headers (registries, plan_executors, etc.) — also
# machine output, not decision-making code. Excluded from the language bar.
src/dag-fft-compiler/generator/generated/** linguist-generated

# Benchmarks, dev scratch, and tests — kept in the repo for users, but not
# part of the shipped library, so excluded from the language bar.
build_tuned/benches/** linguist-vendored
build_tuned/dev/**     linguist-vendored
build_tuned/test/**    linguist-vendored
# Every C file anywhere under build_tuned (bench_compilers/, future probe
# dirs, stray root-level harnesses) — same rationale.
build_tuned/**/*.c     linguist-vendored

# DAG-compiler experiments — probe/sandbox campaigns, not shipped library
# code. Excluded from the language bar.
src/dag-fft-compiler/experiments/** linguist-vendored

# Cost-model code (and its generated tables) — excluded from the language bar.
src/dag-fft-compiler/generator/cost_model/** linguist-vendored

# JIT runtime-codegen OUTPUT (machine-generated .c/.dll codelets emitted at
# runtime). Visible/browsable in the repo, but excluded from the language bar —
# same rationale as the static codelets.
src/dag-fft-compiler/jit/generated/** linguist-generated

# The language bar represents the shipped library = src/core. Everything else
# C-shaped is scaffolding: build-system probes, the public-header shim,
# generator-side tooling, and the JIT prelude/runtime C surface.
cmake/**                                  linguist-vendored
include/**                                linguist-vendored
src/dag-fft-compiler/generator/scripts/** linguist-vendored
src/dag-fft-compiler/jit/**               linguist-vendored

# Generator-level shell helpers (codelet regeneration / codegen comparison).
# Tooling, not shipped library code — same rationale as generator/scripts/.
src/dag-fft-compiler/generator/*.sh        linguist-vendored

# Research notes, roadmaps, wisdom records and performance ledgers. These are
# the project's written record, not its product — counted as documentation so
# the language bar reflects CODE (README.md and in-tree .md stay counted).
docs/** linguist-documentation

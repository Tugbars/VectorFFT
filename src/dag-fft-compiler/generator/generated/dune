; Auto-emitted headers (section 38h): regenerated and promoted into the
; source tree by `dune build` whenever the emitters change.

; IL (interleaved-complex) registry: extern decls + radix X-macro lists for
; the 253 corpus-covered IL cells, consumed by src/core/oop/il2p.h.
(rule
 (targets il_registry_avx2.h)
 (deps %{exe:../bin/emit_il_registry.exe})
 (mode promote)
 (action
  (with-stdout-to il_registry_avx2.h
   (run %{exe:../bin/emit_il_registry.exe}))))

; ZTURN-T: the FUSED CODELETS (the pow2 whole-transform functions, one per
; cell) live in fused_codelets/ with their own promote rule and README —
; owner's ruling 2026-09-14: they are the pow2 solution's executable form, the
; composable stage kernels in codelets/zil/avx2/boundary_split are the
; product. Only the registry stays here.

(rule
 (targets ztt_registry_avx2.h)
 (deps %{exe:../bin/emit_ztt_registry.exe})
 (mode promote)
 (action
  (with-stdout-to
   ztt_registry_avx2.h
   (run %{exe:../bin/emit_ztt_registry.exe} --isa avx2))))

; zturn-ts (2026-11-04): the SPLIT library's fused-driver registry, derived
; from the same cell list as fused_codelets/zts_drivers_* (Zts_drivers.cells)
(rule
 (targets zts_registry_avx2.h)
 (deps %{exe:../bin/emit_zts_registry.exe})
 (mode promote)
 (action
  (with-stdout-to zts_registry_avx2.h
   (run %{exe:../bin/emit_zts_registry.exe} --isa avx2))))

